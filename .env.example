# ---------------------------------------------------------------------------
# Copy to .env and fill in ONE provider. .env is gitignored -- never commit it.
# ---------------------------------------------------------------------------

# Which provider profile to use. See PROFILES in aip/config.py.
#   local           -> cached all-MiniLM-L6-v2 embeddings + ms-marco cross-encoder.
#                      No API key, no network once the models are cached. This is
#                      the default and the one the gate runs against, because
#                      `make gate` has to work on a cold machine.
#   ollama          -> local models for chat as well, if you want generation.
#                      Needs `ollama serve` and `ollama pull <model>`.
#   gemini          -> generous free tier.
#   nvidia          -> NVIDIA NIM developer key.
#   groq            -> free tier
#   anthropic | openai -> paid
AIP_PROFILE=local

# --- keys: none needed for AIP_PROFILE=local or ollama ------------------------
# GEMINI_API_KEY=
# NVIDIA_API_KEY=          # from build.nvidia.com -- starts with nvapi-
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# (local and ollama need no key -- ollama also needs `ollama serve`)

# --- cost safety -----------------------------------------------------------
# Hard ceiling for one process. Trips BudgetExceeded and stops the run.
# Raise it deliberately, never reflexively.
AIP_BUDGET_USD=2.0

# --- caching ---------------------------------------------------------------
AIP_CACHE=1          # 1 = identical requests are free and instant
AIP_OFFLINE=0        # 1 = replay cache only; a cache miss raises instead of spending

# --- strict offline ---------------------------------------------------------
# AIP_PROFILE=local needs no network *once* the two Hugging Face models are
# cached. Setting these makes that explicit and silences the "sending
# unauthenticated requests to the HF Hub" warning you get on every run
# otherwise. Do not set them before the first `make index`, or the download of
# the models themselves will be blocked too.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# --- generation ------------------------------------------------------------
AIP_TEMPERATURE=0.0  # deterministic by default. Raise it deliberately, per call.
AIP_TIMEOUT_S=60

# --- corpus ----------------------------------------------------------------
# Where the pinned IndiaCode snapshot lives, and where the built corpus goes.
# Left at the defaults; shown here so it is discoverable.
# STATUTE_DATA_DIR=data
