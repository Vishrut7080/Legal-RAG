.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.env

# Traces are per-machine observability scratch, not a deliverable.
.aip_traces/

# The corpus index is derived from data/corpus and is rebuilt by
# `make index`. It is ~2 MB, so we commit it: that is what lets
# AIP_OFFLINE=1 replay the golden set with no network and no API key.
# Commit data/raw/ for the same reason -- it is the pinned snapshot that
# data/corpus was built from, so the corpus is reproducible without a
# network fetch.

# The model-response cache is scratch, not a deliverable. This project does not
# need it for offline replay: retrieval replays against the committed
# data/index/matrix.npy and generation is extractive, so `make gate` runs with
# no network and no API key regardless. It is kept for anyone who turns on the
# LLM path (--llm) and wants repeat runs to be free.
.aip_cache/*.sqlite3
.aip_cache/chroma/*

# The answer cache is machine-local state: it exists to make a running service
# faster, and its contents are reproducible by asking the questions again.
# The *measurement* of the cache is committed instead, in
# data/eval/cache_sweep.json -- that is the part worth reviewing.
data/cache/

# Wall clock from the gate is machine-specific: it measures the laptop, not the
# system. Untracked on purpose. The reproducible metrics live in
# data/eval/results.json, which is committed.
reports/gate_timing.local.json